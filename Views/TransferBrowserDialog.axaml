<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pia="using:PhosphorIconsAvalonia.Markup"
        xmlns:models="using:sy_ftp.Models"
        x:Class="sy_ftp.Views.TransferBrowserDialog"
        Width="560" Height="520"
        MinWidth="460" MinHeight="400"
        WindowDecorations="None"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Border.dialog-card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.dialog-btn-primary /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog-btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
        </Style>
        <Style Selector="Button.dialog-btn-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryActive}" />
        </Style>
        <Style Selector="Button.dialog-btn-outline /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1Start}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog-btn-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.dialog-btn-outline:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>

        <Style Selector="Button.dialog-btn-danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog-btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLightPointerover}" />
        </Style>
        <Style Selector="Button.dialog-btn-danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLightActive}" />
        </Style>

        <!-- Dir list item -->
        <Style Selector="ListBox.dir-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.dir-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.dir-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.dir-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>

        <!-- Host combobox popup -->
        <Style Selector="ComboBox#HostCombo /template/ Popup Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
        </Style>
        <Style Selector="ComboBox#HostCombo ComboBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Styles>

    <Border x:Name="CardBorder"
            Classes="dialog-card"
            CornerRadius="12" Margin="8"
            Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid RowDefinitions="44,Auto,Auto,*,Auto,Auto">

            <!-- Title bar (draggable) -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    PointerPressed="OnTitleBarDrag">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <PathIcon Data="{pia:IconGeometry Icon=arrow_fat_right, IconType=fill}"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource SemiColorPrimary}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   VerticalAlignment="Center"
                                   Text="Transfer to" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="OnCloseClick"
                            Classes="dialog-btn-outline"
                            Background="Transparent" BorderThickness="0"
                            Padding="6" CornerRadius="6"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Close">
                        <PathIcon Data="{pia:IconGeometry Icon=x, IconType=regular}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorText2}" />
                    </Button>
                </Grid>
            </Border>

            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                       Fill="{DynamicResource SemiColorBorder}" />

            <!-- Host picker row -->
            <Border Grid.Row="1" Padding="14,10"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="Destination"
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource SemiColorText1}" />
                    <ComboBox Grid.Column="1"
                              x:Name="HostCombo"
                              HorizontalAlignment="Stretch"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SemiColorBorder}"
                              Background="{DynamicResource SemiColorFill0}"
                              CornerRadius="8"
                              Padding="10,5"
                              PlaceholderText="Select a host..."
                              SelectionChanged="OnHostSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FtpHost">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Ellipse Grid.Column="0"
                                             Width="7" Height="7"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SemiColorSuccess}"
                                             IsVisible="{Binding IsConnected}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Host}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SemiColorText3}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                Margin="10,0,0,0">
                        <Button x:Name="ConnectButton"
                                Click="OnConnectClick"
                                Classes="dialog-btn-primary"
                                Background="{DynamicResource SemiColorPrimary}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="6" Padding="14,6"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{pia:IconGeometry Icon=plug, IconType=fill}"
                                          Width="13" Height="13" />
                                <TextBlock Text="Connect" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DisconnectButton"
                                Click="OnDisconnectClick"
                                Classes="dialog-btn-danger"
                                Foreground="{DynamicResource SemiColorDanger}"
                                BorderThickness="0"
                                CornerRadius="6" Padding="14,6"
                                IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{pia:IconGeometry Icon=x_circle, IconType=regular}"
                                          Width="13" Height="13" />
                                <TextBlock Text="Disconnect" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Path breadcrumb + buttons -->
            <Border Grid.Row="2" Padding="14,8"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,0,0,1"
                    IsEnabled="{Binding #DirListBox.IsVisible}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Classes="dialog-btn-outline"
                            Click="OnUpClick"
                            Padding="6" CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Up one level">
                        <PathIcon Data="{pia:IconGeometry Icon=arrow_bend_left_up, IconType=regular}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorText1}" />
                    </Button>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SemiColorFill0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="8,0,8,0">
                        <TextBlock x:Name="PathBlock"
                                   Text="/"
                                   FontSize="12"
                                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace"
                                   Foreground="{DynamicResource SemiColorText1}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button Grid.Column="2"
                            Classes="dialog-btn-outline"
                            Click="OnRefreshClick"
                            Padding="6" CornerRadius="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Refresh">
                        <PathIcon Data="{pia:IconGeometry Icon=arrow_clockwise, IconType=regular}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorText1}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Directory list / empty-state / loading -->
            <Grid Grid.Row="3">
                <ListBox x:Name="DirListBox"
                         Classes="dir-list"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8"
                         IsVisible="False"
                         DoubleTapped="OnDirDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RemoteFile">
                            <Border Padding="10,5,10,5" Margin="0"
                                    CornerRadius="6"
                                    Background="Transparent">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{pia:IconGeometry Icon=folder_simple, IconType=regular}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource SemiColorPrimary}" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state (no connection yet) -->
                <StackPanel x:Name="EmptyPanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <PathIcon Data="{pia:IconGeometry Icon=cloud, IconType=regular}"
                              Width="44" Height="44"
                              Foreground="{DynamicResource SemiColorText3}" />
                    <TextBlock x:Name="EmptyLabel"
                               Text="Pick a destination host, then click Connect"
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="300"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Loading overlay -->
                <StackPanel x:Name="LoadingPanel"
                            IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="4"
                                 Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock x:Name="LoadingLabel"
                               Text="Connecting..."
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ErrorLabel"
                           IsVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Margin="24,0"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SemiColorDanger}" />
            </Grid>

            <!-- Transfer progress -->
            <Border Grid.Row="4"
                    x:Name="ProgressPanel"
                    IsVisible="False"
                    Padding="14,6"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,1,0,0">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ProgressLabel" FontSize="11"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <ProgressBar x:Name="ProgressBarCtl"
                                 IsIndeterminate="False"
                                 Minimum="0" Maximum="100"
                                 Height="4"
                                 Foreground="{DynamicResource SemiColorPrimary}" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="5"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="TargetSummary"
                               FontSize="11"
                               Foreground="{DynamicResource SemiColorText3}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Close" Click="OnCloseClick"
                                Classes="dialog-btn-outline"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                Foreground="{DynamicResource SemiColorText1}"
                                CornerRadius="6" Padding="14,6" />
                        <Button x:Name="TransferButton"
                                Content="Transfer here" Click="OnTransferClick"
                                Classes="dialog-btn-primary"
                                Background="{DynamicResource SemiColorPrimary}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="6" Padding="14,6"
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

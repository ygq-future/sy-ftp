<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:sy_ftp.Models"
        xmlns:pia="using:PhosphorIconsAvalonia.Markup"
        xmlns:l="using:sy_ftp.Markup"
        x:Class="sy_ftp.Views.HostEditWindow"
        x:DataType="models:FtpHost"
        Width="420" Height="560"
        Title="Host"
        WindowDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

    <Design.DataContext>
        <models:FtpHost Name="My Server" Host="ftp.example.com"/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Dialog card entry animation: fade + slight scale-up -->
        <Style Selector="Border.dialog-card">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Primary save button — matches RemoteEditWindow -->
        <Style Selector="Button.dialog-btn-primary /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog-btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
        </Style>
        <Style Selector="Button.dialog-btn-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryActive}" />
        </Style>

        <!-- Outline cancel button — matches RemoteEditWindow -->
        <Style Selector="Button.dialog-btn-outline /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1Start}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog-btn-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="Button.dialog-btn-outline:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>

        <!-- Field-level error hint: fade in -->
        <Style Selector="TextBlock.field-error">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
    </Window.Styles>

    <!-- Margin gives the BoxShadow room to render beyond the card -->
    <Border x:Name="CardBorder"
            Classes="dialog-card"
            CornerRadius="12" Margin="8" Padding="24"
            Background="{DynamicResource SemiColorBackground1}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            PointerPressed="OnCardDrag">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header — drag area -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                <PathIcon Data="{pia:IconGeometry Icon=desktop, IconType=regular}"
                          Width="22" Height="22"
                          Foreground="{DynamicResource SemiColorPrimary}" />
                <TextBlock Text="{l:Tr hostedit.header}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" Spacing="8">

                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr hostedit.field.name}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBox x:Name="NameBox"
                             Text="{Binding Name, Mode=TwoWay}"
                             PlaceholderText="{l:Tr hostedit.field.name.placeholder}"
                             Background="{DynamicResource SemiColorFill0}"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             CornerRadius="6" Padding="10,7" />
                    <TextBlock x:Name="NameError"
                               Classes="field-error"
                               IsVisible="False"
                               Text="{l:Tr hostedit.field.name.required}" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr hostedit.field.host}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBox x:Name="HostBox"
                             Text="{Binding Host, Mode=TwoWay}"
                             PlaceholderText="{l:Tr hostedit.field.host.placeholder}"
                             Background="{DynamicResource SemiColorFill0}"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             CornerRadius="6" Padding="10,7" />
                    <TextBlock x:Name="HostError"
                               Classes="field-error"
                               IsVisible="False"
                               Text="{l:Tr hostedit.field.host.required}" />
                </StackPanel>

                <Grid ColumnDefinitions="100,*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                        <TextBlock Text="{l:Tr hostedit.field.port}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBox Text="{Binding Port, Mode=TwoWay}"
                                 Background="{DynamicResource SemiColorFill0}"
                                 BorderBrush="{DynamicResource SemiColorBorder}"
                                 CornerRadius="6" Padding="10,7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                        <TextBlock Text="{l:Tr hostedit.field.username}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBox Text="{Binding Username, Mode=TwoWay}"
                                 PlaceholderText="{l:Tr hostedit.field.username.placeholder}"
                                 Background="{DynamicResource SemiColorFill0}"
                                 BorderBrush="{DynamicResource SemiColorBorder}"
                                 CornerRadius="6" Padding="10,7" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr hostedit.field.password}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBox Text="{Binding Password, Mode=TwoWay}"
                             PasswordChar="&#x2022;"
                             PlaceholderText="{l:Tr hostedit.field.password.placeholder}"
                             Background="{DynamicResource SemiColorFill0}"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             CornerRadius="6" Padding="10,7" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr hostedit.field.tags}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBox Text="{Binding Tags, Mode=TwoWay}"
                             PlaceholderText="{l:Tr hostedit.field.tags.placeholder}"
                             Background="{DynamicResource SemiColorFill0}"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             CornerRadius="6" Padding="10,7" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr hostedit.field.download_path}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 Text="{Binding DownloadPath, Mode=TwoWay}"
                                 PlaceholderText="{l:Tr hostedit.field.download_path.placeholder}"
                                 Background="{DynamicResource SemiColorFill0}"
                                 BorderBrush="{DynamicResource SemiColorBorder}"
                                 CornerRadius="6" Padding="10,7" />
                        <Button Grid.Column="1"
                                Click="OnBrowseDownloadPathClick"
                                Classes="dialog-btn-outline"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                Foreground="{DynamicResource SemiColorText1}"
                                Content="{l:Tr hostedit.field.download_path.browse}"
                                CornerRadius="6" Padding="12,6" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Buttons — unified with RemoteEditWindow -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="{l:Tr hostedit.btn.cancel}" Click="Cancel_Click"
                        Classes="dialog-btn-outline"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        Foreground="{DynamicResource SemiColorText1}"
                        CornerRadius="6" Padding="14,6" />
                <Button Content="{l:Tr hostedit.btn.save}" Click="Ok_Click"
                        Classes="dialog-btn-primary"
                        Background="{DynamicResource SemiColorPrimary}"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6" Padding="14,6" />
            </StackPanel>

        </Grid>
    </Border>
</Window>

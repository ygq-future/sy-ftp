<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:sy_ftp.ViewModels"
        xmlns:models="using:sy_ftp.Models"
        xmlns:sys="using:System"
        xmlns:pia="using:PhosphorIconsAvalonia.Markup"
        xmlns:conv="using:sy_ftp.Converters"
        xmlns:svc="using:sy_ftp.Services"
        xmlns:l="using:sy_ftp.Markup"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="sy_ftp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Classes.has-bg="{Binding HasBackgroundImage}"
        Title="SY-FTP"
        Topmost="{Binding IsTopmost}"
        Width="900" Height="560"
        MinWidth="680" MinHeight="440"
        Background="{DynamicResource SemiColorBackground0}"
        FontSize="13"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:BoolInverter x:Key="BoolInverter" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:NotNullOrEmptyConverter x:Key="NotNullOrEmptyConverter" />
        <conv:StringToOpacityConverter x:Key="StringToOpacity" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <conv:FileIconGeometryConverter x:Key="FileIconGeometry" />
        <conv:FileIconBrushConverter x:Key="FileIconBrush" />
        <conv:TagLabelConverter x:Key="TagLabel" />
    </Window.Resources>

    <Window.Styles>

        <!-- ── Global ToolTip delay: negative BetweenShowDelay disables the
             "immediate open on adjacent control" behavior. Every tooltip must
             wait the full ShowDelay, so fast sweeps across a button row stay
             silent instead of strobing. ── -->
        <Style Selector=":is(Control)">
            <Setter Property="ToolTip.ShowDelay" Value="550" />
            <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
        </Style>

        <!-- ── Icon-only ToggleButton: suppress all checked/hover background ── -->
        <Style Selector="ToggleButton.icon-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:checked">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1Start}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.icon-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1Start}" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <Style Selector="ToggleButton.icon-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>

        <!-- ── Accent-text button: foreground stays SemiColorPrimary in all states ── -->
        <Style Selector="Button.accent-text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <!-- Suppress Button-level background flash from Semi theme -->
        <Style Selector="Button.accent-text:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.accent-text:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.accent-text /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent-text:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimaryPointerover}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="Button.accent-text:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimaryActive}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
        </Style>
        <Style Selector="Button.accent-text:disabled /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimaryDisabled}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
        </Style>

        <!-- ── Sidebar Add button ── -->
        <Style Selector="Button.sidebar-add-btn:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sidebar-add-btn:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sidebar-add-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebar-add-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="Button.sidebar-add-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
        </Style>

        <!-- ── Sidebar Delete button ── -->
        <Style Selector="Button.sidebar-delete-btn:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sidebar-delete-btn:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.sidebar-delete-btn /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLightStart}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebar-delete-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
        </Style>
        <Style Selector="Button.sidebar-delete-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorDangerLightActive}" />
        </Style>

        <!-- ── Window control buttons (min/max/close) ── -->
        <!-- v12 custom caption buttons reuse the accent-text style to match
             the theme/pin/settings buttons on their left — no red close,
             no fixed 44-px slabs. -->

        <!-- ── Host ListBoxItem: transparent in every state, selection shown on card ── -->
        <Style Selector="ListBox.host-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ── Host card: primary highlight when selected ── -->
        <Style Selector="ListBox.host-list ListBoxItem Border.host-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.has-bg ListBox.host-list ListBoxItem Border.host-card">
            <!-- Use SemiColorPrimaryLightStart (zero-alpha version of PrimaryLight) instead
                 of Transparent. Transparent (#00FFFFFF) would interpolate through a white
                 tint during BrushTransition, flashing in dark theme. Same-hue start avoids
                 the flash while keeping the smooth fade. -->
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:pointerover Border.host-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        </Style>
        <!-- has-bg: use accent tint instead of fill1 so dark theme doesn't darken too much -->
        <Style Selector="Window.has-bg ListBox.host-list ListBoxItem:pointerover Border.host-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:selected Border.host-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.host-list ListBoxItem:selected:pointerover Border.host-card">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
        </Style>

        <!-- ── Accent color swatch: radial glow halo on hover ── -->
        <!-- Suppress Semi theme's gray overlay on the Button root -->
        <Style Selector="Button.accent-swatch /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.accent-swatch:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.accent-swatch:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Halo: BoxShadow on inner Border expands on hover -->
        <Style Selector="Border.swatch-halo">
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent-swatch:pointerover Border.swatch-halo">
            <Setter Property="BoxShadow" Value="0 0 12 3 #66FFFFFF" />
        </Style>
        <Style Selector="Button.accent-swatch:pressed Border.swatch-halo">
            <Setter Property="BoxShadow" Value="0 0 6 1 #66FFFFFF" />
        </Style>

        <!-- ── ComboBox dropdown: rounded popup + rounded items ── -->
        <Style Selector="ComboBox#TagComboBox /template/ Popup Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0" />
                        <Setter Property="TranslateTransform.Y" Value="-6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Arrow rotation animation: match Path OR PathIcon so works with any Semi theme version -->
        <Style Selector="ComboBox#TagComboBox /template/ ToggleButton Path">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox#TagComboBox:dropdownopen /template/ ToggleButton Path">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="ComboBox#TagComboBox /template/ ToggleButton PathIcon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ComboBox#TagComboBox:dropdownopen /template/ ToggleButton PathIcon">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="ComboBox#TagComboBox ComboBoxItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <!-- Instant hover switch: no transition, eliminates any intermediate white flash -->
        <Style Selector="ComboBox#TagComboBox ComboBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="ComboBox#TagComboBox ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ComboBox#TagComboBox ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ComboBox#TagComboBox ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- ── Context menu ── -->
        <Style Selector="ContextMenu /template/ Popup Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
        </Style>
        <!-- MenuItem submenu popup: same chrome as ContextMenu popup -->
        <Style Selector="MenuItem /template/ Popup#PART_Popup Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
        </Style>
        <Style Selector="MenuItem /template/ Popup Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
        </Style>
        <Style Selector="MenuItem /template/ ScrollViewer">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ContextMenu Separator">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource SemiColorBorder}" />
        </Style>
        <!-- Applies to both ContextMenu items AND submenu items (submenus live in their own popup) -->
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <!-- Instant hover switch: no transition, eliminates any intermediate white flash -->
        <Style Selector="MenuItem /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="MenuItem:selected /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="MenuItem PathIcon">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>
        <!-- Separators inside submenu popups need the same styling -->
        <Style Selector="MenuItem Separator">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource SemiColorBorder}" />
        </Style>

        <!-- ── File ListBoxItem: accent hover & selection ── -->
        <Style Selector="ListBox.file-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem /template/ ContentPresenter">
            <!-- Use SemiColorPrimaryLightStart (zero-alpha PrimaryLight) for the idle background.
                 Visually identical to Transparent but transitions through the same hue, so the
                 fade-in to PrimaryLight on hover doesn't flash white in dark theme. -->
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
        </Style>
        <Style Selector="ListBox.file-list ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
        </Style>
        <!-- Drop target highlight during internal drag-move -->
        <Style Selector="ListBox.file-list ListBoxItem.drop-target /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Flyout presenter: strip chrome via class selector -->
        <Style Selector="FlyoutPresenter.path-overflow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Overflow flyout items: larger corner radius matching panel -->
        <Style Selector="Button.overflow-item">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Overflow flyout: accent hover, rounded, compact -->
        <Style Selector="ListBox.overflow-flyout ListBoxItem">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.overflow-flyout ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightStart}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.overflow-flyout ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
        </Style>
        <Style Selector="ListBox.overflow-flyout ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
        </Style>

        <!-- ── Path bar: transparent when background image is set ── -->
        <Style Selector="Border.path-bar">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Window.has-bg Border.path-bar">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ── Tag ComboBox: transparent when background image is set ── -->
        <Style Selector="ComboBox#TagComboBox">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
        <Style Selector="Window.has-bg ComboBox#TagComboBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </Window.Styles>

    <!-- Root: background layer + title bar row + content rows -->
    <Panel>
        <!-- Full-window background image layer (behind everything, covers title bar) -->
        <Image Source="{Binding BackgroundImage}"
               Stretch="UniformToFill"
               Opacity="{Binding BackgroundOpacity}"
               IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Main content grid -->
        <Grid RowDefinitions="38,*,Auto"
              DoubleTapped="OnAnywhereDoubleTapped">

        <!-- ══════════════════════════════════════════
             Custom Title Bar / Toolbar Row
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Background="Transparent"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              PointerPressed="OnTitleBarPointerPressed"
              DoubleTapped="OnTitleBarDoubleTapped">

            <!-- Left: Connect / Disconnect -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                <!-- macOS 红绿灯留白 -->
                <Border x:Name="MacTrafficLightSpacer" Width="0" />

                <Button Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding IsNotConnected}"
                        Classes="accent-text"
                        Padding="12,0" Height="28" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.connect.tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{pia:IconGeometry Icon=plug, IconType=fill}"
                                  Width="14" Height="14" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium"
                                   Text="{l:Tr toolbar.connecting}"
                                   IsVisible="{Binding IsBusy}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium"
                                   Text="{l:Tr toolbar.connect}"
                                   IsVisible="{Binding IsBusy, Converter={StaticResource BoolInverter}}" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Classes="accent-text"
                        Padding="10,0" Height="28" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.disconnect.tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{pia:IconGeometry Icon=x_circle, IconType=regular}"
                                  Width="14" Height="14" />
                        <TextBlock Text="{l:Tr toolbar.disconnect}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Column="1"
                       Width="1" Margin="8,8"
                       Fill="{DynamicResource SemiColorBorder}" />

            <!-- Middle: file actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding FileBrowser.RefreshCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Classes="accent-text"
                        Padding="10,0" Height="28" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.refresh.tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{pia:IconGeometry Icon=arrow_clockwise, IconType=regular}"
                                  Width="14" Height="14" />
                        <TextBlock Text="{l:Tr toolbar.refresh}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right: theme / pin / settings toggles -->
            <StackPanel x:Name="RightButtonGroup"
                        Grid.Column="3" Orientation="Horizontal" Spacing="1" Margin="0,0,2,0">

                <Button Command="{Binding ToggleThemeCommand}"
                        Classes="accent-text"
                        Padding="9,0" Height="32" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.theme.tooltip}">
                    <Panel>
                        <PathIcon Data="{pia:IconGeometry Icon=sun, IconType=fill}"
                                  Width="16" Height="16"
                                  Opacity="{Binding IsDarkMode, Converter={StaticResource BoolToOpacity}}">
                            <PathIcon.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </PathIcon.Transitions>
                        </PathIcon>
                        <PathIcon Data="{pia:IconGeometry Icon=moon, IconType=fill}"
                                  Width="16" Height="16"
                                  Opacity="{Binding IsDarkMode, Converter={StaticResource BoolToOpacity}, ConverterParameter=invert}">
                            <PathIcon.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </PathIcon.Transitions>
                        </PathIcon>
                    </Panel>
                </Button>

                <ToggleButton IsChecked="{Binding IsTopmost}"
                              Classes="icon-toggle"
                              Padding="9,0" Height="32" CornerRadius="7"
                              ToolTip.Tip="{l:Tr toolbar.topmost.tooltip}">
                    <Panel>
                        <PathIcon Data="{pia:IconGeometry Icon=push_pin_simple, IconType=fill}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SemiColorPrimary}"
                                  Opacity="{Binding IsTopmost, Converter={StaticResource BoolToOpacity}}">
                            <PathIcon.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </PathIcon.Transitions>
                        </PathIcon>
                        <PathIcon Data="{pia:IconGeometry Icon=push_pin_simple, IconType=regular}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource SemiColorText2}"
                                  Opacity="{Binding IsTopmost, Converter={StaticResource BoolToOpacity}, ConverterParameter=invert}">
                            <PathIcon.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </PathIcon.Transitions>
                        </PathIcon>
                    </Panel>
                </ToggleButton>

                <Button Command="{Binding OpenSettingsCommand}"
                        Classes="accent-text"
                        Padding="9,0" Height="32" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.settings.tooltip}">
                    <PathIcon Data="{pia:IconGeometry Icon=gear, IconType=regular}"
                              Width="16" Height="16"
                              Foreground="{DynamicResource SemiColorText1}" />
                </Button>

            </StackPanel>

            <!-- Column 4: custom min / max / close buttons.
                 WindowDecorations="Full" keeps WS_CAPTION for DWM animations,
                 but Avalonia no longer draws native buttons, so we supply our own. -->
            <StackPanel x:Name="CustomWindowControls"
                        Grid.Column="4" Orientation="Horizontal" Spacing="1" Margin="2,0,6,0">
                <Button Classes="accent-text"
                        Click="OnMinimizeClick"
                        Padding="9,0" Height="32" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.minimize.tooltip}">
                    <PathIcon Data="{pia:IconGeometry Icon=minus, IconType=regular}"
                              Width="16" Height="16"
                              Foreground="{DynamicResource SemiColorText1}" />
                </Button>
                <Button Classes="accent-text"
                        Click="OnMaxRestoreClick"
                        Padding="9,0" Height="32" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.maxrestore.tooltip}">
                    <Panel>
                        <PathIcon Data="{pia:IconGeometry Icon=square, IconType=regular}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorText1}"
                                  IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static conv:WindowStateToBoolConverter.IsNormal}}" />
                        <PathIcon Data="{pia:IconGeometry Icon=squares_four, IconType=regular}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SemiColorText1}"
                                  IsVisible="{Binding $parent[Window].WindowState, Converter={x:Static conv:WindowStateToBoolConverter.IsMaximized}}" />
                    </Panel>
                </Button>
                <Button Classes="accent-text"
                        Click="OnCloseClick"
                        Padding="9,0" Height="32" CornerRadius="7"
                        ToolTip.Tip="{l:Tr toolbar.close.tooltip}">
                    <PathIcon Data="{pia:IconGeometry Icon=x, IconType=regular}"
                              Width="16" Height="16"
                              Foreground="{DynamicResource SemiColorText1}" />
                </Button>
            </StackPanel>

        </Grid>

        <!-- thin separator line below title bar -->
        <Rectangle Grid.Row="0"
                   Height="1" VerticalAlignment="Bottom"
                   Fill="{DynamicResource SemiColorBorder}" />

        <!-- ══════════════════════════════════════════
             Main Content (sidebar | gap | browser)
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="220,6,*" Margin="8,8,8,0">

            <!-- ── Sidebar Card ── -->
            <Panel Grid.Column="0">
                <!-- Fill layer: full opacity when no bg image, subtle tint otherwise -->
                <Border CornerRadius="12"
                        Background="{DynamicResource SemiColorNavBackground}"
                        Opacity="{Binding PanelFillOpacity}" />
                <!-- Outline + content layer -->
                <Border CornerRadius="12"
                        BoxShadow="0 2 8 0 #1A000000"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{l:Tr sidebar.hosts}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource SemiColorText0}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Command="{Binding HostManager.AddHostCommand}"
                                        Classes="sidebar-add-btn"
                                        Padding="8,3" CornerRadius="6"
                                        FontSize="11" FontWeight="Medium"
                                        Foreground="{DynamicResource SemiColorPrimary}"
                                        BorderThickness="0"
                                        ToolTip.Tip="{l:Tr sidebar.add.tooltip}"
                                        Content="{l:Tr sidebar.add}" />
                                <Button Command="{Binding HostManager.DeleteHostCommand}"
                                        CommandParameter="{Binding HostManager.SelectedHost}"
                                        Classes="sidebar-delete-btn"
                                        Padding="8,3" CornerRadius="6"
                                        FontSize="11" FontWeight="Medium"
                                        Foreground="{DynamicResource SemiColorDanger}"
                                        BorderThickness="0"
                                        ToolTip.Tip="{l:Tr sidebar.delete.tooltip}"
                                        Content="{l:Tr sidebar.delete}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tag Filter -->
                    <Border Grid.Row="1" Padding="8,7"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1">
                        <ComboBox x:Name="TagComboBox"
                                  SelectedItem="{Binding HostManager.FilterTag, Mode=TwoWay}"
                                  ItemsSource="{Binding HostManager.AllTagOptions}"
                                  HorizontalAlignment="Stretch"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource SemiColorBorder}"
                                  CornerRadius="8"
                                  Padding="10,5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:TagLabelConverter.Instance}">
                                                <Binding />
                                                <Binding Path="Language" Source="{x:Static svc:LocalizationService.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>

                    <!-- Host List -->
                    <ListBox Grid.Row="2"
                             x:Name="HostListBox"
                             Classes="host-list"
                             ItemsSource="{Binding HostManager.FilteredHosts}"
                             SelectedItem="{Binding HostManager.SelectedHost, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="{DynamicResource SemiColorNavBackground}">
                                <MenuItem Header="{l:Tr host.menu.connect}"
                                          Command="{Binding ConnectCommand}"
                                          IsEnabled="{Binding IsNotConnected}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{pia:IconGeometry Icon=plug, IconType=regular}"
                                                  Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr host.menu.disconnect}"
                                          Command="{Binding DisconnectCommand}"
                                          IsEnabled="{Binding IsConnected}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{pia:IconGeometry Icon=x_circle, IconType=regular}"
                                                  Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:Tr host.menu.edit}"
                                          Command="{Binding HostManager.EditHostCommand}"
                                          CommandParameter="{Binding HostManager.SelectedHost}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{pia:IconGeometry Icon=pencil_simple, IconType=regular}"
                                                  Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr host.menu.delete}"
                                          Command="{Binding HostManager.DeleteHostCommand}"
                                          CommandParameter="{Binding HostManager.SelectedHost}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{pia:IconGeometry Icon=trash_simple, IconType=regular}"
                                                  Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:Tr host.menu.add}"
                                          Command="{Binding HostManager.AddHostCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{pia:IconGeometry Icon=plus_circle, IconType=regular}"
                                                  Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FtpHost">
                                <Border Classes="host-card"
                                        Padding="10,9" Margin="0,0,0,4"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource SemiColorBorder}"
                                        BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                        <Ellipse Grid.Row="0" Grid.Column="0"
                                                 Width="7" Height="7"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 Fill="{DynamicResource SemiColorSuccess}"
                                                 IsVisible="{Binding IsConnected}"
                                                 ToolTip.Tip="{l:Tr file.tip.connected}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Name}"
                                                   FontWeight="Medium" FontSize="13"
                                                   Foreground="{DynamicResource SemiColorText0}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="{Binding Host}"
                                                   FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Row="1" Grid.Column="2"
                                                IsVisible="{Binding Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Background="{DynamicResource SemiColorPrimaryLight}"
                                                CornerRadius="4" Padding="5,2" Margin="6,2,0,0">
                                            <TextBlock Text="{Binding Tags}" FontSize="9"
                                                       Foreground="{DynamicResource SemiColorPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>
            </Panel>

            <!-- gap column — no splitter -->

            <!-- ── File Browser Card ── -->
            <Panel Grid.Column="2">
                <!-- Fill layer: full opacity when no bg image, subtle tint otherwise -->
                <Border CornerRadius="12"
                        Background="{DynamicResource SemiColorBackground0}"
                        Opacity="{Binding PanelFillOpacity}" />
                <!-- Outline + content layer -->
                <Border CornerRadius="12"
                        BoxShadow="0 2 8 0 #1A000000"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Path breadcrumb -->
                    <Border Grid.Row="0" Padding="12,6"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1">
                        <Border Classes="path-bar"
                                CornerRadius="8" Padding="10,5"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsConnected}"
                                DoubleTapped="OnPathBarDoubleTapped">
                            <StackPanel Spacing="4">
                                <!-- Normal path display -->
                                <Grid IsVisible="{Binding FileBrowser.IsEditingPath, Converter={StaticResource BoolInverter}}"
                                      ColumnDefinitions="*,Auto">
                                    <ScrollViewer Grid.Column="0"
                                                  x:Name="PathScrollViewer"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <PathIcon Data="{pia:IconGeometry Icon=folder_simple, IconType=regular}"
                                                      Width="15" Height="15" Margin="0,0,6,0"
                                                      Foreground="{DynamicResource SemiColorText2}"
                                                      VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding FileBrowser.PathSegments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PathSegment">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <!-- Overflow collapse button -->
                                                        <Button Classes="accent-text" Padding="3,1"
                                                                IsVisible="{Binding IsOverflow}">
                                                            <TextBlock Text="…" FontSize="12"
                                                                       Foreground="{DynamicResource SemiColorText1}" />
                                                            <Button.Flyout>
                                                                <Flyout FlyoutPresenterClasses="path-overflow">
                                                                    <Border Background="{DynamicResource SemiColorBackground1}"
                                                                            CornerRadius="10" Padding="4"
                                                                            BorderBrush="{DynamicResource SemiColorBorder}"
                                                                            BorderThickness="1">
                                                                        <ItemsControl ItemsSource="{Binding DataContext.FileBrowser.OverflowPathSegments, ElementName=RootWindow}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Spacing="1" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:PathSegment">
                                                                                    <Border CornerRadius="8" ClipToBounds="True">
                                                                                        <Button Classes="accent-text overflow-item" Padding="8,2"
                                                                                                HorizontalAlignment="Stretch"
                                                                                                Command="{Binding DataContext.FileBrowser.NavigateToPathCommand, ElementName=RootWindow}"
                                                                                                CommandParameter="{Binding FullPath}">
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontSize="12"
                                                                                                       Foreground="{DynamicResource SemiColorText1}" />
                                                                                        </Button>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Border>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <TextBlock Text="/" FontSize="12"
                                                                   Foreground="{DynamicResource SemiColorText3}"
                                                                   IsVisible="{Binding IsOverflow}"
                                                                   VerticalAlignment="Center" />
                                                        <!-- Normal segment (hidden when overflow) -->
                                                        <StackPanel IsVisible="{Binding IsOverflow, Converter={StaticResource BoolInverter}}"
                                                                    Orientation="Horizontal" Spacing="2">
                                                            <Button Classes="accent-text" Padding="2,1"
                                                                    Command="{Binding DataContext.FileBrowser.NavigateToPathCommand, ElementName=RootWindow}"
                                                                    CommandParameter="{Binding FullPath}"
                                                                    IsVisible="{Binding IsLast, Converter={StaticResource BoolInverter}}">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource SemiColorText1}" />
                                                            </Button>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource SemiColorText0}"
                                                                       FontWeight="SemiBold"
                                                                       IsVisible="{Binding IsLast}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="/" FontSize="12"
                                                                       Foreground="{DynamicResource SemiColorText3}"
                                                                       IsVisible="{Binding ShowSeparator}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <!-- Buttons always visible on right -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                                        <Button Classes="accent-text" Padding="4,2"
                                                Click="OnEditPathClick"
                                                ToolTip.Tip="{l:Tr file.path.edit.tooltip}">
                                            <PathIcon Data="{pia:IconGeometry Icon=pencil_simple, IconType=regular}"
                                                      Width="13" Height="13"
                                                      Foreground="{DynamicResource SemiColorText3}" />
                                        </Button>
                                        <Button Classes="accent-text" Padding="4,2"
                                                Click="OnCopyPathClick"
                                                ToolTip.Tip="{l:Tr file.path.copy.tooltip}">
                                            <PathIcon Data="{pia:IconGeometry Icon=copy, IconType=regular}"
                                                      Width="13" Height="13"
                                                      Foreground="{DynamicResource SemiColorText3}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Edit mode -->
                                <StackPanel IsVisible="{Binding FileBrowser.IsEditingPath}"
                                            Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{pia:IconGeometry Icon=folder_simple, IconType=regular}"
                                              Width="15" Height="15"
                                              Foreground="{DynamicResource SemiColorText2}"
                                              VerticalAlignment="Center" />
                                    <TextBox Text="{Binding FileBrowser.EditPathText}"
                                             x:Name="PathEditBox"
                                             FontFamily="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace" FontSize="12"
                                             Width="400"
                                             KeyDown="OnPathEditKeyDown" />
                                    <Button Classes="accent-text" Padding="4,2"
                                            Command="{Binding FileBrowser.NavigateToEditPathCommand}"
                                            ToolTip.Tip="{l:Tr file.path.edit.go.tooltip}">
                                        <PathIcon Data="{pia:IconGeometry Icon=arrow_right, IconType=regular}"
                                                  Width="14" Height="14"
                                                  Foreground="{DynamicResource SemiColorPrimary}" />
                                    </Button>
                                    <Button Classes="accent-text" Padding="4,2"
                                            Command="{Binding FileBrowser.CancelPathEditCommand}"
                                            ToolTip.Tip="{l:Tr file.path.edit.cancel.tooltip}">
                                        <PathIcon Data="{pia:IconGeometry Icon=x, IconType=regular}"
                                                  Width="14" Height="14"
                                                  Foreground="{DynamicResource SemiColorText2}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Sort header bar -->
                    <Border Grid.Row="1" Padding="8,2,0,2"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Grid.ColumnSpan="2"
                                    Classes="accent-text" Padding="0,2"
                                    HorizontalAlignment="Left"
                                    Command="{Binding FileBrowser.ToggleSortCommand}"
                                    CommandParameter="{x:Static vm:FileSortColumn.Name}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="{l:Tr file.col.name}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource SemiColorPrimary}"
                                               Text="{Binding FileBrowser.NameSortArrow}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="accent-text" Padding="0,2"
                                    HorizontalAlignment="Left"
                                    Margin="-4,0,0,0"
                                    Command="{Binding FileBrowser.ToggleSortCommand}"
                                    CommandParameter="{x:Static vm:FileSortColumn.Size}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="{l:Tr file.col.size}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource SemiColorPrimary}"
                                               Text="{Binding FileBrowser.SizeSortArrow}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="4" Text="{l:Tr file.col.owner}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       VerticalAlignment="Center" Padding="0,2" Margin="-2,0,0,0" />
                            <TextBlock Grid.Column="5" Text="{l:Tr file.col.permissions}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       VerticalAlignment="Center" Padding="0,2" Margin="-3,0,0,0" />
                            <Button Grid.Column="6" Classes="accent-text" Padding="4,2"
                                    HorizontalAlignment="Left"
                                    Margin="-7,0,0,0"
                                    Command="{Binding FileBrowser.ToggleSortCommand}"
                                    CommandParameter="{x:Static vm:FileSortColumn.LastModified}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="{l:Tr file.col.modified}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource SemiColorPrimary}"
                                               Text="{Binding FileBrowser.ModifiedSortArrow}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- File list area -->
                    <Grid Grid.Row="2">

                        <!-- Floating toasts (copy + path error) -->
                        <Border IsVisible="{Binding FileBrowser.ShowCopyToast}"
                                Background="{DynamicResource SemiColorBackground1}"
                                CornerRadius="8"
                                BoxShadow="0 2 12 0 #28000000"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                Padding="14,8"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,12,0,0"
                                ZIndex="10"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{pia:IconGeometry Icon=check_circle, IconType=fill}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource SemiColorSuccess}" />
                                <TextBlock Text="{l:Tr file.path.copied}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SemiColorSuccess}" />
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding FileBrowser.PathError, Converter={StaticResource NotNullOrEmptyConverter}}"
                                Background="{DynamicResource SemiColorBackground1}"
                                CornerRadius="8"
                                BoxShadow="0 2 12 0 #28000000"
                                BorderBrush="{DynamicResource SemiColorDanger}"
                                BorderThickness="1"
                                Padding="14,8"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,12,0,0"
                                ZIndex="10"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{pia:IconGeometry Icon=warning_circle, IconType=fill}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource SemiColorDanger}" />
                                <TextBlock Text="{Binding FileBrowser.PathError}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SemiColorDanger}" />
                            </StackPanel>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Opacity="{Binding IsNotConnected, Converter={StaticResource BoolToOpacity}}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                </Transitions>
                            </StackPanel.Transitions>
                            <PathIcon Data="{pia:IconGeometry Icon=cloud, IconType=regular}"
                                      Width="52" Height="52"
                                      Foreground="{DynamicResource SemiColorText3}" />
                            <TextBlock Text="{l:Tr file.empty.title}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- File list -->
                        <ListBox x:Name="FileListBox"
                                 ItemsSource="{Binding FileBrowser.Files}"
                                 SelectedItem="{Binding FileBrowser.SelectedFile, Mode=TwoWay}"
                                 SelectionMode="Multiple"
                                 Classes="file-list"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="4,2,4,2"
                                 DoubleTapped="OnFileListDoubleTapped"
                                 Tapped="OnFileListTapped"
                                 KeyDown="OnFileListKeyDown"
                                 DragDrop.AllowDrop="True"
                                 DragDrop.DragOver="OnFileListDragOver"
                                 DragDrop.Drop="OnFileListDrop">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Tr file.menu.refresh}"
                                              Command="{Binding FileBrowser.RefreshCommand}"
                                              IsEnabled="{Binding IsConnected}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{pia:IconGeometry Icon=arrow_clockwise, IconType=regular}"
                                                      Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{l:Tr file.menu.new_folder}"
                                              Command="{Binding FileBrowser.NewFolderCommand}"
                                              IsEnabled="{Binding IsConnected}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{pia:IconGeometry Icon=folder_simple_plus, IconType=regular}"
                                                      Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Tr file.menu.new_file}"
                                              Command="{Binding FileBrowser.NewFileCommand}"
                                              IsEnabled="{Binding IsConnected}">
                                        <MenuItem.Icon>
                                            <PathIcon Data="{pia:IconGeometry Icon=file_plus, IconType=regular}"
                                                      Width="14" Height="14" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RemoteFile">
                                    <Border Padding="10,3,0,3" Margin="0"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            ContextRequested="OnFileItemContextRequested">
                                        <Border.ContextMenu>
                                            <ContextMenu x:Name="ItemContextMenu"
                                                         IsVisible="{Binding !IsParentEntry}">
                                                <MenuItem Header="{l:Tr file.menu.download}" Click="OnItemDownloadClick">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=download_simple, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.download_to}" Click="OnItemDownloadToClick">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=folder_open, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.remote_edit}"
                                                          Click="OnItemRemoteEditClick"
                                                          IsVisible="{Binding DataContext.FileBrowser.AllSelectedAreFiles, ElementName=RootWindow}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=pencil_simple, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.online_edit}"
                                                          Click="OnItemOnlineEditClick"
                                                          IsVisible="{Binding DataContext.FileBrowser.AllSelectedAreFiles, ElementName=RootWindow}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=code, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.transfer_to}"
                                                          Click="OnItemTransferToClick">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=arrow_fat_right, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.rename}"
                                                          Click="OnItemRenameClick"
                                                          IsVisible="{Binding DataContext.FileBrowser.HasMultiSelection, ElementName=RootWindow, Converter={StaticResource BoolInverter}}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=pencil_line, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.delete}" Click="OnItemDeleteClick">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=trash_simple, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator x:Name="ItemContextMenuSeparator"
                                                           IsVisible="{Binding DataContext.FileBrowser.HasMultiSelection, ElementName=RootWindow, Converter={StaticResource BoolInverter}}" />
                                                <MenuItem Header="{l:Tr file.menu.refresh}"
                                                          Command="{Binding DataContext.FileBrowser.RefreshCommand, ElementName=RootWindow}"
                                                          IsVisible="{Binding DataContext.FileBrowser.HasMultiSelection, ElementName=RootWindow, Converter={StaticResource BoolInverter}}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=arrow_clockwise, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.new_folder}"
                                                          Command="{Binding DataContext.FileBrowser.NewFolderCommand, ElementName=RootWindow}"
                                                          IsVisible="{Binding DataContext.FileBrowser.HasMultiSelection, ElementName=RootWindow, Converter={StaticResource BoolInverter}}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=folder_simple_plus, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{l:Tr file.menu.new_file}"
                                                          Command="{Binding DataContext.FileBrowser.NewFileCommand, ElementName=RootWindow}"
                                                          IsVisible="{Binding DataContext.FileBrowser.HasMultiSelection, ElementName=RootWindow, Converter={StaticResource BoolInverter}}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{pia:IconGeometry Icon=file_plus, IconType=regular}"
                                                                  Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="45" />
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <!-- ".." entry -->
                                            <PathIcon Grid.Column="0"
                                                      Data="{pia:IconGeometry Icon=arrow_bend_left_up, IconType=regular}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource SemiColorText2}"
                                                      IsVisible="{Binding IsParentEntry}" />
                                            <TextBlock Grid.Column="1" Text=".."
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       IsVisible="{Binding IsParentEntry}" />
                                            <!-- Normal entries -->
                                            <PathIcon Grid.Column="0"
                                                      Data="{pia:IconGeometry Icon=folder, IconType=fill}"
                                                      Width="18" Height="18" Margin="0,0,10,0"
                                                      Foreground="{DynamicResource SemiColorPrimary}"
                                                      IsVisible="{Binding IsDirectory}" />
                                            <PathIcon Grid.Column="0"
                                                      Data="{Binding Name, Converter={StaticResource FileIconGeometry}}"
                                                      Width="18" Height="18" Margin="0,0,10,0"
                                                      Foreground="{Binding Name, Converter={StaticResource FileIconBrush}}"
                                                      IsVisible="{Binding IsDirectory, Converter={StaticResource BoolInverter}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SemiColorText0}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding IsParentEntry, Converter={StaticResource BoolInverter}}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       IsVisible="{Binding IsDirectory, Converter={StaticResource BoolInverter}}" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Owner}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding IsParentEntry, Converter={StaticResource BoolInverter}}" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding Permissions}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontFamily="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace"
                                                       IsVisible="{Binding IsParentEntry, Converter={StaticResource BoolInverter}}" />
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText3}"
                                                       IsVisible="{Binding IsParentEntry, Converter={StaticResource BoolInverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Rubber-band selection overlay -->
                        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                            <Border x:Name="SelectionRect"
                                    IsVisible="False"
                                    Background="{DynamicResource SemiColorPrimaryLight}"
                                    BorderBrush="{DynamicResource SemiColorPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Opacity="0.4" />
                        </Canvas>

                        <!-- Drag ghost: follows cursor during internal drag -->
                        <Canvas x:Name="DragGhostCanvas" IsHitTestVisible="False" IsVisible="False">
                            <Border x:Name="DragGhost"
                                    Background="{DynamicResource SemiColorBackground1}"
                                    BorderBrush="{DynamicResource SemiColorPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    BoxShadow="0 4 12 0 #28000000"
                                    Padding="10,6"
                                    Opacity="0.88">
                                <TextBlock x:Name="DragGhostLabel"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource SemiColorText0}"
                                           MaxWidth="200"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Canvas>

                        <!-- Error overlay (after ListBox so it renders on top) -->
                        <Border Opacity="{Binding FileBrowser.ErrorMessage, Converter={StaticResource StringToOpacity}}"
                                IsHitTestVisible="{Binding FileBrowser.ErrorMessage, Converter={StaticResource NotNullOrEmptyConverter}}"
                                Background="{DynamicResource SemiColorBackground1}"
                                CornerRadius="12"
                                BoxShadow="0 0 20 0 #18000000"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                Padding="24,20"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel HorizontalAlignment="Center" Spacing="12">
                                <PathIcon Data="{pia:IconGeometry Icon=warning_circle, IconType=regular}"
                                          Width="36" Height="36"
                                          Foreground="{DynamicResource SemiColorDanger}" />
                                <TextBlock Text="{Binding FileBrowser.ErrorMessage}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SemiColorDanger}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="400"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>
            </Border>
            </Panel>

        </Grid>

        <!-- ══════════════════════════════════════════
             Status Bar
             ══════════════════════════════════════════ -->
        <Panel Grid.Row="2" Margin="8,6,8,8">
            <!-- Fill layer: full opacity when no bg image, subtle tint otherwise -->
            <Border CornerRadius="12"
                    Background="{DynamicResource SemiColorBackground1}"
                    Opacity="{Binding PanelFillOpacity}" />
            <!-- Outline + content layer -->
            <Border CornerRadius="12"
                    BoxShadow="0 2 6 0 #14000000"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    Padding="14,5">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                <Panel Grid.Column="0" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <PathIcon Data="{pia:IconGeometry Icon=circle, IconType=fill}"
                              Width="9" Height="9"
                              Foreground="{DynamicResource SemiColorDanger}"
                              Opacity="{Binding IsNotConnected, Converter={StaticResource BoolToOpacity}}">
                        <PathIcon.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </PathIcon.Transitions>
                    </PathIcon>
                    <PathIcon Data="{pia:IconGeometry Icon=circle, IconType=fill}"
                              Width="9" Height="9"
                              Foreground="{DynamicResource SemiColorSuccess}"
                              Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacity}}">
                        <PathIcon.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                            </Transitions>
                        </PathIcon.Transitions>
                    </PathIcon>
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                           FontSize="12" Foreground="{DynamicResource SemiColorText1}"
                           VerticalAlignment="Center" />
                <!-- Indeterminate: connecting / directory loading -->
                <ProgressBar Grid.Column="2"
                             Opacity="{Binding IsStatusLoading, Converter={StaticResource BoolToOpacity}}"
                             IsHitTestVisible="False"
                             IsIndeterminate="True" Width="90" Height="4" Margin="10,0"
                             Foreground="{DynamicResource SemiColorPrimary}">
                    <ProgressBar.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </ProgressBar.Transitions>
                </ProgressBar>
                <!-- Determinate: file download -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            Opacity="{Binding FileBrowser.IsDownloading, Converter={StaticResource BoolToOpacity}}"
                            IsHitTestVisible="{Binding FileBrowser.IsDownloading}"
                            Margin="10,0">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </StackPanel.Transitions>
                    <ProgressBar IsIndeterminate="False"
                                 Value="{Binding FileBrowser.DownloadProgress}"
                                 Minimum="0" Maximum="100"
                                 Width="120" Height="4"
                                 Foreground="{DynamicResource SemiColorPrimary}">
                        <ProgressBar.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Value" Duration="0:0:0.2" />
                            </Transitions>
                        </ProgressBar.Transitions>
                    </ProgressBar>
                    <TextBlock Text="{Binding FileBrowser.DownloadStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource SemiColorText2}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Separator Grid.Column="3" Width="1" Margin="10,3"
                           Background="{DynamicResource SemiColorBorder}"
                           Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacity}}"
                           IsHitTestVisible="False">
                    <Separator.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                        </Transitions>
                    </Separator.Transitions>
                </Separator>
                <TextBlock Grid.Column="4"
                           Text="{Binding FileBrowser.ItemCountDisplay}"
                           FontSize="11" Margin="0,0,2,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText3}"
                           Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacity}}"
                           IsHitTestVisible="False">
                    <TextBlock.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                        </Transitions>
                    </TextBlock.Transitions>
                </TextBlock>
                <Separator Grid.Column="5" Width="1" Margin="10,3"
                           Background="{DynamicResource SemiColorBorder}"
                           Opacity="{Binding FileBrowser.LastSyncTime, Converter={StaticResource StringToOpacity}}"
                           IsHitTestVisible="False" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            Opacity="{Binding FileBrowser.LastSyncTime, Converter={StaticResource StringToOpacity}}"
                            IsHitTestVisible="{Binding FileBrowser.LastSyncTime, Converter={StaticResource NotNullOrEmptyConverter}}">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                        </Transitions>
                    </StackPanel.Transitions>
                    <PathIcon Data="{pia:IconGeometry Icon=arrow_counter_clockwise, IconType=regular}"
                              Width="11" Height="11"
                              Foreground="{DynamicResource SemiColorSuccess}" />
                    <TextBlock Text="{Binding FileBrowser.LastSyncDisplay}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorSuccess}" />
                </StackPanel>
            </Grid>
        </Border>
        </Panel>

    </Grid>
    </Panel>

</Window>

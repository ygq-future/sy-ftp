<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\sy-ftp.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <!-- 单文件 -->
        <PublishSingleFile>true</PublishSingleFile>

        <!-- 自包含 -->
        <SelfContained>true</SelfContained>

        <!-- 裁剪 -->
        <PublishTrimmed>false</PublishTrimmed>

        <!-- ReadyToRun 提升启动速度 -->
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="FluentFTP" Version="54.1.2" />
        <PackageReference Include="PhosphorIconsAvalonia" Version="1.2.0" />
        <PackageReference Include="Semi.Avalonia" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="SSH.NET" Version="2025.1.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>

    <!-- Suppress NuGet vulnerability audit warnings (NU1900) on macOS:
         dotnet processes launched from iTerm2 cannot write to the NuGet http-cache
         due to macOS TCC restrictions. This is a known issue:
         https://github.com/NuGet/Home/issues/13071 -->
    <PropertyGroup>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <!-- Suppress Avalonia.BuildServices telemetry task (macOS TCC denies log file) -->
    <ItemGroup>
        <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="build;buildTransitive" />
    </ItemGroup>
</Project>

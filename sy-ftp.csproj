<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\sy-ftp.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- 版本信息 -->
        <Version>1.0.3</Version>
        <AssemblyVersion>1.0.3</AssemblyVersion>
        <FileVersion>1.0.3</FileVersion>
        <!-- 裁剪 -->
        <PublishTrimmed>false</PublishTrimmed>
        <!-- 关闭调试符号 -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <!-- 禁用 NuGet 漏洞审计以避免网络警告 -->
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <!-- 删除调试文件 -->
    <Target Name="RemoveDebugSymbols" AfterTargets="Publish">
        <ItemGroup>
            <DebugFiles Include="$(PublishDir)**\*.pdb" />
        </ItemGroup>

        <Delete Files="@(DebugFiles)" />
    </Target>
    
    <ItemGroup>
        <Folder Include="Models\" />
        <!-- 包含运行时需要的图标文件，排除源文件目录 -->
        <AvaloniaResource Include="Assets\sy-ftp.ico" />
        <AvaloniaResource Include="Assets\sy-ftp.icns" />
        <AvaloniaResource Include="Assets\sy-ftp.png" />
        <!-- 排除 icons 源文件目录，减少发布包体积 -->
        <!-- <AvaloniaResource Include="Assets\icons\**" /> -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="FluentFTP" Version="54.1.2" />
        <PackageReference Include="PhosphorIconsAvalonia" Version="1.2.0" />
        <PackageReference Include="Semi.Avalonia" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="SSH.NET" Version="2025.1.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>
</Project>
